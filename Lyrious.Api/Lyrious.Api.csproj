<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3851f35d-e270-4beb-91f4-32b6601297b2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Gmail.v1" Version="1.78.0.4327" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="MimeKit" Version="5.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lyrious.CoreLib\Lyrious.CoreLib.csproj" />
    <!-- The web app (WebAssembly) and the product website: not code this project uses, but their
         files (the compiled app under /app/, the site at the root) are served by the API, so the
         website, the web app and the API share one address. -->
    <ProjectReference Include="..\Lyrious.Webapp\Lyrious.Webapp.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <!-- (Its files only: not its own program, which would otherwise be copied along.) -->
    <ProjectReference Include="..\Lyrious.Website\Lyrious.Website.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
